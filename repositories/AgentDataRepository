const AgentData = require("../models/AgentDataModel");
const logger = require("../logger");

async function createAgentData(agentData) {
  try {
    const agentDataPojo = new AgentData(agentData);
    const createdAgentData = await agentDataPojo.save();
    return createdAgentData;
  } catch (error) {
    logger.error(
      `Error occurred while creating data for agent with phoneNumber=${agentData.phoneNumber}, name=${agentData.name}, error=${error}`
    );
    throw new Error(
      `Error occurred while creating data for agent with phoneNumber=${agentData.phoneNumber}, name=${agentData.name}, error=${error}`
    );
  }
}

